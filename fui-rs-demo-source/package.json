{
  "name": "fui-rs-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "publish": "npm run build:web && npm run build:native && npm run publish:stage",
    "build:web": "npm run build:assets && npm run build:wasm && npm run build:workers && npm run build:harness && npm run stage:routes",
    "build:wasm": "node scripts/build-route-wasm.mjs --release",
    "build:workers": "node scripts/build-worker-wasm.mjs --release",
    "build:native": "node scripts/build-native.mjs --release",
    "publish:stage": "node -e \"const fs=require('node:fs');fs.rmSync('published',{recursive:true,force:true});fs.cpSync('public','published',{recursive:true})\"",
    "stage:routes": "node scripts/stage-route-entrypoints.mjs",
    "check:published-routes": "node scripts/stage-route-entrypoints.mjs --check --output=published",
    "check:published-mfe": "node scripts/check-published-mfe.mjs published",
    "build:assets": "node scripts/prepare-runtime.mjs",
    "build:harness": "esbuild harness.ts --bundle --format=esm --platform=browser --loader:.json=json --outfile=public/harness.js && npm run build:worker-bootstrap && npm run build:worker-host-services",
    "build:worker-bootstrap": "esbuild @effindomv2/runtime/worker-bootstrap --bundle --format=iife --platform=browser --outfile=public/worker-bootstrap.js",
    "build:worker-host-services": "esbuild worker-host-services.ts --bundle --format=esm --platform=browser --outfile=public/worker-host-services.js"
  },
  "dependencies": {
    "@effindomv2/runtime": "0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true
  }
}
