{
  "name": "fui-rs-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "publish": "cargo fui build --release && npm run stage:routes && rm -rf published && cp -R public published",
    "stage:routes": "node scripts/stage-route-entrypoints.mjs",
    "check:published-routes": "node scripts/stage-route-entrypoints.mjs --check --output=published",
    "build:assets": "node scripts/prepare-runtime.mjs",
    "build:harness": "esbuild harness.ts --bundle --format=esm --platform=browser --loader:.json=json --outfile=public/harness.js && npm run build:worker-bootstrap && npm run build:worker-host-services",
    "build:worker-bootstrap": "esbuild @effindomv2/runtime/worker-bootstrap --bundle --format=iife --platform=browser --outfile=public/worker-bootstrap.js",
    "build:worker-host-services": "esbuild worker-host-services.ts --bundle --format=esm --platform=browser --outfile=public/worker-host-services.js"
  },
  "dependencies": {
    "@effindomv2/runtime": "0.2.14"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
